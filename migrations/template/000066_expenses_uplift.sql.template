-- ============================================================
-- TEMPLATE 000066 — Expenses module uplift (per-business)
-- Vendor expenses, partial payments, expanded types/statuses,
-- expense_payments ledger, COA gap-fill.
-- ============================================================

ALTER TABLE {{BUSINESS}}.expenses ALTER COLUMN profile_id DROP NOT NULL;

ALTER TABLE {{BUSINESS}}.expenses
  ADD COLUMN IF NOT EXISTS vendor_name        TEXT,
  ADD COLUMN IF NOT EXISTS vendor_contact_id  UUID REFERENCES shared.contacts (contact_id) ON DELETE SET NULL,
  ADD COLUMN IF NOT EXISTS submitted_by       UUID REFERENCES shared.users (user_id) ON DELETE SET NULL,
  ADD COLUMN IF NOT EXISTS amount_paid        NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (amount_paid >= 0),
  ADD COLUMN IF NOT EXISTS auto_approved      BOOLEAN NOT NULL DEFAULT false;

ALTER TABLE {{BUSINESS}}.expenses DROP CONSTRAINT IF EXISTS expenses_expense_type_check;
ALTER TABLE {{BUSINESS}}.expenses ADD CONSTRAINT expenses_expense_type_check
  CHECK (expense_type IN ('reimbursement','petty_cash','direct_payment','cash_advance_retirement'));

ALTER TABLE {{BUSINESS}}.expenses DROP CONSTRAINT IF EXISTS expenses_status_check;
ALTER TABLE {{BUSINESS}}.expenses ADD CONSTRAINT expenses_status_check
  CHECK (status IN ('pending','approved','rejected','partially_paid','paid'));

ALTER TABLE {{BUSINESS}}.expenses DROP CONSTRAINT IF EXISTS chk_expenses_payee;
ALTER TABLE {{BUSINESS}}.expenses ADD CONSTRAINT chk_expenses_payee
  CHECK (profile_id IS NOT NULL OR vendor_name IS NOT NULL OR vendor_contact_id IS NOT NULL);

CREATE TABLE IF NOT EXISTS {{BUSINESS}}.expense_payments (
  payment_id     UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
  expense_id     UUID          NOT NULL REFERENCES {{BUSINESS}}.expenses (expense_id) ON DELETE CASCADE,
  amount         NUMERIC(12,2) NOT NULL CHECK (amount > 0),
  payment_date   DATE          NOT NULL DEFAULT CURRENT_DATE,
  method         TEXT          NOT NULL DEFAULT 'bank_transfer'
                 CHECK (method IN ('bank_transfer','cash','card','petty_cash','other')),
  reference      TEXT,
  notes          TEXT,
  recorded_by    UUID          REFERENCES shared.users (user_id) ON DELETE SET NULL,
  created_at     TIMESTAMPTZ   NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS idx_{{BUSINESS}}_expense_payments ON {{BUSINESS}}.expense_payments (expense_id, payment_date DESC);

ALTER TABLE {{BUSINESS}}.cash_advances DROP CONSTRAINT IF EXISTS cash_advances_status_check;
ALTER TABLE {{BUSINESS}}.cash_advances ADD CONSTRAINT cash_advances_status_check
  CHECK (status IN ('pending','approved','disbursed','settled','rejected','cancelled'));


# ============================================================
# Hub Platform — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or .env.production to git.
# ============================================================

NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:7000,http://localhost:5173,https://orikaliving.com,https://www.orikaliving.com
HUB_BASE_URL=http://localhost:7000

# ── PostgreSQL ────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_POOL_MAX=20

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────
# to generate a secure JWT secret, use;
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# ── Storage ───────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# For S3:
# STORAGE_DRIVER=s3
# S3_BUCKET=hub-platform-files
# S3_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=sk_test_CHANGE_ME
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME

# ── Flutterwave ───────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWSECK_TEST_CHANGE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-CHANGE_ME
FLUTTERWAVE_WEBHOOK_SECRET=CHANGE_ME

# ── Optimus Pay (OnePipe) ─────────────────────────────────
# API Key + Secret Key from the Optimus Pay console → API Settings.
# Copy them EXACTLY — no quotes, no trailing spaces (the Signature header
# is MD5(request_ref;secret), so one stray character 401s every call).
OPTIMUS_PAY_API_KEY=CHANGE_ME
OPTIMUS_PAY_CLIENT_SECRET=CHANGE_ME
# Name registered on every provisioned virtual account (what payers see
# on name-enquiry before transferring).
OPTIMUS_PAY_ACCOUNT_NAME=ORIKA LIVING LTD
# Must match the app's mode on the Optimus dashboard. Only "Live" or
# "Inspect" exist — anything else → "Request mode not supported".
OPTIMUS_PAY_MOCK_MODE=Live
# Re-query /v2/transact/query before fulfilling webhook payments.
# Anything except "off" enables it. Only set "off" against the local mock.
OPTIMUS_PAY_WEBHOOK_VERIFY=on
# LEAVE UNSET in production — defaults to https://api.onepipe.io.
# Local dev against the mock only:
#   OPTIMUS_PAY_BASE_URL=http://localhost:7100
#   OPTIMUS_PAY_NOTIFICATION_URL=http://localhost:7000/api/webhooks/optimus
# (In production the webhook URL is configured on the Optimus dashboard:
#  https://app.orikaliving.com/api/webhooks/optimus)


# ── Shopify (if connected) ────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# ── WooCommerce (if connected) ────────────────────────────
# WC_SITE_URL=
# WC_CONSUMER_KEY=
# WC_CONSUMER_SECRET=
# WC_WEBHOOK_SECRET=

# ── Meta (Instagram + Facebook) ──────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=CHANGE_ME_RANDOM
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# ── TikTok ────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── YouTube ───────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── WhatsApp Business ─────────────────────────────────────
WHATSAPP_API_TOKEN=<api_token>
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_RANDOM
WHATSAPP_PHONE_ID_JEWELRY=<phone_number_id_bejewelled>
WHATSAPP_PHONE_ID_DIFFUSERS=<phone_number_id_orika_living>
META_ACCESS_TOKEN=<page_access_token>
META_VERIFY_TOKEN=<webhook_verify_token>
CAMPAIGN_APPROVAL_THRESHOLD=50
WA_DAILY_SEND_LIMIT=1000      

# ── Chowdeck ──────────────────────────────────────────────
CHOWDECK_API_KEY=
CHOWDECK_BASE_URL=https://api.chowdeck.com

# ── GIGL ─────────────────────────────────────────────────
GIGL_CLIENT_ID=
GIGL_CLIENT_SECRET=
GIGL_BASE_URL=https://api.gigl.com

# ── SMTP ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourbrand.com
SMTP_PASS=CHANGE_ME
SMTP_FROM_NAME=Hub Platform
SMTP_FROM_EMAIL=noreply@yourbrand.com
# Per-brand sender overrides (falls back to SMTP_FROM_* above)
SMTP_FROM_NAME_JEWELRY=Orika Living
SMTP_FROM_EMAIL_JEWELRY=noreply@orikaliving.com
SMTP_FROM_NAME_DIFFUSERS=Bejewelled
SMTP_FROM_EMAIL_DIFFUSERS=noreply@bejewelled.com
